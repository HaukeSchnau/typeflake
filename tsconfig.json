{
  "extends": "@schnau/tsconfig/effect",
  "compilerOptions": {
    "types": ["node"],
    // This list replaces the base's `plugins`, so it repeats the Effect entry.
    "plugins": [
      {
        "name": "@effect/language-service",
        // The `effecttsgo/unstable-api-usage` lint rule reports unstable Effect APIs outside the CLI's
        // files, which vite.config.ts lists. The type checker would report them in every file.
        "diagnosticSeverity": { "unstableApiUsage": "off" }
      }
    ]
  },
  "include": ["src", "*.ts"]
}
