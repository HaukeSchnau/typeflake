{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node strips types; enums and namespaces can't run.
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // The `effecttsgo/unstable-api-usage` lint rule reports unstable Effect APIs outside the CLI's
        // files, which vite.config.ts lists. The type checker would report them in every file.
        "diagnosticSeverity": { "unstableApiUsage": "off" }
      }
    ]
  },
  "include": ["src", "*.ts"]
}
