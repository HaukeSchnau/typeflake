{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [],
    // `import site from "./site.nix"` reads the declaration `typeflake types` wrote for it.
    "allowArbitraryExtensions": true,
    "rootDirs": [".", ".typeflake/files"]
  },
  "include": ["**/*.nix.ts", ".typeflake/**/*.ts"]
}
